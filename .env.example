# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# ─── NextAuth ────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-a-random-32-char-secret-here
NEXTAUTH_URL=https://your-domain.vercel.app

# ─── Admin Credentials (set before running seed) ────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-password-here

# ─── Coordinator Credentials (optional) ─────────────────────────────────
COORDINATOR_USERNAME=coordinator
COORDINATOR_EMAIL=coordinator@example.com
COORDINATOR_PASSWORD=change-me

# ─── Food Admin Credentials (optional) ─────────────────────────────────
FOOD_ADMIN_USERNAME=food_admin
FOOD_ADMIN_EMAIL=food@example.com
FOOD_ADMIN_PASSWORD=change-me

# ─── BERSERK Recovery Secret ─────────────────────────────────────────────
HM3_BERSERK_SECRET=your-48-char-recovery-secret

# ─── Resend Email (transactional emails) ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Hackmitten <noreply@your-verified-domain.com>

# ─── Vercel Blob Storage ────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
BLOB_STORE_ID=your-blob-store-id
