# Supabase pooled transaction URL for serverless runtime
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?pgbouncer=true
# Supabase direct/session URL used only by Prisma migrations
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
BACKEND_CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSPORT_BUCKET=passport-images
SUPABASE_IMAGES_BUCKET=images
SUPABASE_PAYMENT_BUCKET=payment-screenshots
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
COORDINATOR_USERNAME=
COORDINATOR_EMAIL=
COORDINATOR_PASSWORD=
FOOD_ADMIN_USERNAME=
FOOD_ADMIN_EMAIL=
FOOD_ADMIN_PASSWORD=
